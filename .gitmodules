# The modules of nornRTOS as git submodules of this repository. The URLs are relative to
# this repository's own remote, so a clone of NornRTOS/nornRTOS gets the public modules
# and a clone of the private development copy gets theirs. tools/submodules.sh registers
# the directories under modules/ (git submodule add on an existing checkout keeps it).
[submodule "modules/nornCore"]
	path = modules/nornCore
	url = ../nornCore.git
[submodule "modules/nornNET"]
	path = modules/nornNET
	url = ../nornNET.git
[submodule "modules/nornWIFI"]
	path = modules/nornWIFI
	url = ../nornWIFI.git
[submodule "modules/nornHTTP"]
	path = modules/nornHTTP
	url = ../nornHTTP.git
[submodule "modules/nornSHELL"]
	path = modules/nornSHELL
	url = ../nornSHELL.git
[submodule "modules/nornStore"]
	path = modules/nornStore
	url = ../nornStore.git
